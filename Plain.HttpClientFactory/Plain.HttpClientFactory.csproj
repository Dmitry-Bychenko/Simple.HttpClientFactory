<Project Sdk="Microsoft.NET.Sdk">

  <!-- Basic Project Properties -->
  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<LangVersion>latest</LangVersion>
	<OutputType>Library</OutputType>
	<Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Code Generation & Language Features -->
  <PropertyGroup>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Build & Analysis Settings -->
  <PropertyGroup>
	<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
	<GenerateDocumentationFile>True</GenerateDocumentationFile>
	<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	<WarningLevel>9999</WarningLevel>
  </PropertyGroup>

  <!-- Package & Publishing Settings -->
  <PropertyGroup>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<IncludeSymbols>True</IncludeSymbols>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	<DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- NuGet Package Metadata -->
  <PropertyGroup>
	<PackageId>Plain.HttpClientFactory</PackageId>
	<Title>Plain.HttpClientFactory</Title>
	<Description>A simple and lightweight HttpClientFactory implementation for .NET</Description>
	<PackageProjectUrl>https://github.com/Dmitry-Bychenko/Simple.HttpClientFactory</PackageProjectUrl>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageIcon>icon.png</PackageIcon>
	<RepositoryUrl>https://github.com/Dmitry-Bychenko/Simple.HttpClientFactory</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<Authors>Dmitrii Bychenko</Authors>
	<Copyright>Copyright (c) 2026 by Dmitrii Bychenko</Copyright>
	<PackageTags>HttpClientFactory;IHttpClientFactory;HTTP;Client</PackageTags>
	<PackageReleaseNotes>Initial stable release
- DefaultHttpClientFactory implementation with shared SocketsHttpHandler
- ClientHttpClientFactory for wrapping existing HttpClient instances
- Extension methods for easy factory creation
- Full unit test coverage with WireMock.Net
- Comprehensive documentation and examples</PackageReleaseNotes>
	<MinClientVersion>5.0</MinClientVersion>
  </PropertyGroup>

  <!-- Dependencies -->
  <ItemGroup>
	<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

  <!-- Package Icon -->
  <ItemGroup>
	<None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
